# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your real values.
# NEVER commit `.env.local` — it is gitignored.
#
# The public site runs fully on bundled seed data with NONE of these set.
# ─────────────────────────────────────────────────────────────

# ── Supabase (optional) ──────────────────────────────────────
# Only powers the private Learning Resources list. Everything else is bundled.
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Found in: Project Settings → API → Project API keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Used by the admin-gated /api/resources route.
# Found in: Project Settings → API → service_role (secret).
# NEVER expose this to the browser / never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin gate (server-side only — NOT NEXT_PUBLIC) ──────────
# The SITE IS PUBLIC. This passcode protects only:
#   · /interview      — personal interview prep
#   · /presentation   — client pitch scripts
#   · writes to /api/resources
#
# FAILS CLOSED: leaving this empty does NOT open those routes — it locks them
# for everyone, including you. Set it to sign in via /unlock.
# Set the same value in Vercel → Settings → Environment Variables.
ADMIN_PASSCODE=
